package com.usuario_service.servicio;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import com.usuario_service.entidades.Usuario;
import com.usuario_service.modelos.Carro;
import com.usuario_service.modelos.Moto;
import com.usuario_service.repositorio.UsuarioRepository;

@Service
public class UsuarioService {

	@Autowired
	private RestTemplate restTemplate;
	
	@Autowired
	private UsuarioRepository usurepo;
	
	 @Value("${servicio.carro.url}")
	 private String carroServiceUrl;
	 
	public List<Usuario> getAll(){
		return usurepo.findAll();
	}
	
	public Usuario getUsuarioById(int id){
		return usurepo.findById(id).orElse(null);
	}
	
	public List<Carro> getCarros(int usuarioId) {
		String url = carroServiceUrl + "/carro/usuario/" + usuarioId;
		//List<Carro> carros = restTemplate.getForObject("http://localhost:8002/carro/usuario/" + usuarioId, List.class);
        List<Carro> carros = restTemplate.getForObject(url, List.class);
		return carros;
	}

	public List<Moto> getMotos(int usuarioId) {
		List<Moto> motos = restTemplate.getForObject("http://localhost:8003/moto/usuario/" + usuarioId, List.class);
		return motos;
	}
	
}
